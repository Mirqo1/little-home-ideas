---
import {categories} from '../data/categories';import {articleUrl} from '../data/articles';
const {article}=Astro.props;const d=article.data;
---
<article class="article-card" data-article-card data-article-id={article.id} data-category={d.category} data-search={(d.title+' '+d.description).toLowerCase()}>
<div class="card-media"><a class="card-image" href={articleUrl(article.id)} tabindex="-1" aria-hidden="true"><img src={d.image} srcset={d.imageSmall ? `${d.imageSmall} 600w, ${d.image} ${d.imageWidth}w` : undefined} sizes="(max-width: 650px) calc(100vw - 48px), (max-width: 900px) 45vw, 380px" alt="" width={d.imageWidth} height={d.imageHeight} loading="lazy" decoding="async"/></a><button class="save-idea" type="button" data-save={article.id} aria-pressed="false" aria-label={`Save ${d.title}`} hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg></button></div><div class="card-copy"><p class="eyebrow">{categories.find(c=>c.slug===d.category)?.navLabel}</p><h3><a href={articleUrl(article.id)}>{d.title}</a></h3><p>{d.description}</p><a class="text-link" href={articleUrl(article.id)}>Read the guide <span aria-hidden="true">→</span><span class="sr-only">: {d.title}</span></a></div></article>
