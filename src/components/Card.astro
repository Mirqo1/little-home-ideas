---
import {categories} from '../data/categories';
import {articleUrl} from '../data/articles';
const {article}=Astro.props;const d=article.data;
---
<article class="article-card"><a class="card-image" href={articleUrl(article.id)} tabindex="-1" aria-hidden="true"><img src={d.image} alt="" width="960" height="640" loading="lazy" decoding="async"/></a><p class="eyebrow">{categories.find(c=>c.slug===d.category)?.name}</p><h3><a href={articleUrl(article.id)}>{d.title}</a></h3><p>{d.description}</p><a class="text-link" href={articleUrl(article.id)}>Read the guide <span aria-hidden="true">↗</span><span class="sr-only">: {d.title}</span></a></article>
