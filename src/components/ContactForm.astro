---
import config from '../data/contact.json';
if (config.enabled && !/^[a-zA-Z0-9]{6,32}$/.test(config.formspreeFormId)) {
  throw new Error('Contact form requires a real Formspree form ID before enabling it.');
}
const ready = config.enabled;
const endpoint = ready ? `https://formspree.io/f/${config.formspreeFormId}` : undefined;
---
<div class="contact-card">
  <h2>Send us a message</h2>
  <p id="contact-help">Have a question about a guide, a correction, or an idea for a useful tool? We would like to hear it.</p>
  {!ready && <div class="notice" id="contact-unavailable" role="status"><strong>Our contact form is being prepared.</strong><p>Please check back soon. Messages cannot be sent yet.</p></div>}
  <form action={endpoint} method="post" accept-charset="UTF-8" aria-describedby={ready ? 'contact-help contact-privacy' : 'contact-help contact-unavailable'}>
    <fieldset disabled={!ready}>
      <legend class="sr-only">Your contact details and message</legend>
      <input type="hidden" name="subject" value="Little Home Ideas: website message"/>
      <input type="hidden" name="_language" value="en"/>
      <input type="text" name="_gotcha" class="spam-trap" tabindex="-1" autocomplete="off" aria-hidden="true"/>
      <div class="contact-field-pair">
        <div><label for="contact-name">Name <span>(optional)</span></label><input id="contact-name" name="name" type="text" autocomplete="name" maxlength="100"/></div>
        <div><label for="contact-email">Email address <span>(required)</span></label><input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required/></div>
      </div>
      <div><label for="contact-topic">What is your message about?</label><select id="contact-topic" name="topic"><option value="Question">A question</option><option value="Correction">A correction to a guide</option><option value="Tool feedback">Feedback about a tool</option><option value="Suggestion">An idea or suggestion</option><option value="Other">Something else</option></select></div>
      <div><label for="contact-message">Message <span>(required)</span></label><textarea id="contact-message" name="message" rows="8" minlength="10" maxlength="5000" required aria-describedby="contact-message-help"></textarea><p id="contact-message-help" class="small">10–5,000 characters. For a correction, include the guide's title or link. Please leave out passwords, payment details, and sensitive personal information.</p></div>
      {ready && <p id="contact-privacy" class="small">Your email and message are sent through Formspree so we can respond to your enquiry. A spam check may appear after you select Send message. Read our <a href="/privacy/#contact-messages">privacy information</a> and <a href="https://formspree.io/legal/privacy-policy/" rel="noopener noreferrer">Formspree's privacy policy</a>.</p>}
      <button type="submit" class="button">Send message <span aria-hidden="true">→</span></button>
    </fieldset>
  </form>
</div>
<style>
  .spam-trap{display:none}
  .contact-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:clamp(24px,4vw,48px)}
  h2{font-size:32px;margin-bottom:18px}.contact-card>p{color:var(--muted);max-width:660px}
  fieldset{border:0;padding:0;margin:0;min-width:0}.contact-field-pair{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  label{display:block;font-weight:650;font-size:14px;margin:20px 0 8px}label span{font-weight:400;color:var(--muted)}
  input,select,textarea{font:inherit;color:var(--ink);background:#fff;width:100%;max-width:100%;min-width:0;padding:12px 14px;border:1px solid #87988c;border-radius:8px}
  textarea{resize:vertical;min-height:180px}textarea:focus-visible{outline:3px solid #a26b3b;outline-offset:5px}
  .small{margin:10px 0 20px;line-height:1.7}.button{margin-top:10px}fieldset:disabled{opacity:.65}.button:disabled,fieldset:disabled .button{cursor:not-allowed}
  @media(max-width:600px){.contact-field-pair{grid-template-columns:1fr;gap:0}}
</style>
