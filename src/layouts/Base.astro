---
import '../styles/site.css';
import { categories } from '../data/categories';
const {title, description, image='/assets/editorial-living.webp', schema, noindex=false} = Astro.props;
const canonical = new URL(Astro.url.pathname==='/404/'?'/404.html':Astro.url.pathname, Astro.site).href;
const current=Astro.url.pathname;
const verification=import.meta.env.GSC_VERIFICATION;
---
<!doctype html><html lang="en-US"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#284634"/><title>{title.includes('Little Home Ideas') ? title : `${title} | Little Home Ideas`}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex && <meta name="robots" content="noindex,follow"/>}{verification && <meta name="google-site-verification" content={verification}/>}
<meta property="og:type" content={schema?.['@type']==='Article' ? 'article':'website'}/><meta property="og:site_name" content="Little Home Ideas"/><meta property="og:locale" content="en_US"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image.endsWith('.svg')?image.replace('.svg','.png'):image,Astro.site).href}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"/>
<script type="application/ld+json" set:html={JSON.stringify(schema || {'@context':'https://schema.org','@type':'WebSite',name:'Little Home Ideas',url:Astro.site.href}).replace(/</g,'\u003c')}/>
</head><body id="top"><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><div class="container masthead"><a href="/" aria-label="Little Home Ideas home"><img class="logo" src="/assets/logo.webp" alt="Little Home Ideas" width="413" height="230"/></a><nav class="header-utility" aria-label="Reader tools"><a href="/ideas/#article-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg>Find an idea</a><a class="saved-link" href="/ideas/#saved-view"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg>Saved ideas <span data-saved-count>0</span></a></nav></div><nav class="container nav" aria-label="Main navigation"><a href="/ideas/" aria-current={current==='/ideas/'?'page':undefined}>All ideas</a>{categories.map(c=><a href={`/${c.slug}/`} aria-current={current===`/${c.slug}/`?'page':undefined}>{c.navLabel}</a>)}<a href="/tools/" aria-current={current.startsWith('/tools/')?'page':undefined}>Free tools</a></nav></header>
<div class="site-ribbon"><span>Practical ideas. Real spaces. A little more possibility.</span><a href="/tools/patio-privacy-planner/">Try our free planner →</a></div><main id="main"><slot/></main>
<footer class="site-footer"><div class="container footer-statement"><p>Big possibilities.<br/><span>Little Home Ideas.</span></p><a class="button" href="/ideas/">Find your next idea →</a></div><div class="container footer-main"><div class="footer-intro"><p class="footer-brand">Little Home Ideas<span>.</span></p><p class="footer-tagline">Small ideas. Better living.</p><p>Practical ideas for the home you have.<br/>Space to make it your own.</p></div><nav aria-label="Footer explore"><h2>Explore</h2><a href="/ideas/">All articles</a><a href="/small-spaces/">Small spaces &amp; storage</a><a href="/garden-patio/">Garden &amp; patio</a><a href="/tools/">Free planning tools</a></nav><nav aria-label="Footer information"><h2>Little Home Ideas</h2><a href="/about/">About us</a><a href="/editorial-policy/">How we create our guides</a><a href="/contact/">Contact</a></nav></div><div class="container footer-bottom"><p>© {new Date().getUTCFullYear()} Little Home Ideas</p><nav aria-label="Legal information"><a href="/privacy/">Privacy</a><a href="/disclosure/">Affiliate disclosure</a></nav><a class="back-top" href="#top">Back to top ↑</a></div></footer>
<div class="save-announcement sr-only" role="status" aria-live="polite" id="save-announcement"></div><script>import '../scripts/magazine.js';</script></body></html>
