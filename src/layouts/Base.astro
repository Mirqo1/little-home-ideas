---
import '../styles/site.css';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import measurement from '../data/measurement.json';
import { categories } from '../data/categories';
const {title, description, image='/assets/home-patio-hero.webp', schema, noindex=false} = Astro.props;
const canonical = new URL(Astro.url.pathname==='/404/'?'/404.html':Astro.url.pathname, Astro.site).href;
const current=Astro.url.pathname;
const verification=measurement.googleSiteVerification.trim() || import.meta.env.GSC_VERIFICATION;
const bingVerification=measurement.bingSiteVerification.trim();
const analyticsId=measurement.ga4MeasurementId.trim();
if(measurement.analyticsEnabled&&!/^G-[A-Z0-9]{6,}$/.test(analyticsId))throw new Error('Analytics requires a real GA4 measurement ID in src/data/measurement.json.');
const analyticsActive=measurement.analyticsEnabled&&/^G-[A-Z0-9]{6,}$/.test(analyticsId);
---
<!doctype html><html lang="en-US"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#294b3c"/><title>{title.includes('Little Home Ideas') ? title : `${title} | Little Home Ideas`}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex && <meta name="robots" content="noindex,follow"/>}{verification && <meta name="google-site-verification" content={verification}/>}{bingVerification && <meta name="msvalidate.01" content={bingVerification}/>}
<meta property="og:type" content={schema?.['@type']==='Article' ? 'article':'website'}/><meta property="og:site_name" content="Little Home Ideas"/><meta property="og:locale" content="en_US"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image.endsWith('.svg')?image.replace('.svg','.png'):image,Astro.site).href}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="/assets/favicon-modern.svg" type="image/svg+xml"/>
<script type="application/ld+json" set:html={JSON.stringify(schema || {'@context':'https://schema.org','@type':'WebSite',name:'Little Home Ideas',url:Astro.site.href}).replace(/</g,'\u003c')}/>
</head><body id="top"><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><div class="container masthead"><a href="/" aria-label="Little Home Ideas home"><img class="logo" src="/assets/wordmark.svg" alt="Little Home Ideas" width="420" height="70"/></a><nav class="header-utility" aria-label="Reader tools"><a href="/ideas/#article-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg>Find an idea</a><a class="saved-link" href="/ideas/#saved-view"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg>Saved ideas <span data-saved-count>0</span></a></nav></div><nav class="container nav" aria-label="Main navigation"><a href="/ideas/" aria-current={current==='/ideas/'?'page':undefined}>All ideas</a>{categories.slice(0,3).map(c=><a href={`/${c.slug}/`} aria-current={current===`/${c.slug}/`?'page':undefined}>{c.navLabel}</a>)}<a href="/tools/" aria-current={current.startsWith('/tools/')?'page':undefined}>Free tools</a></nav></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="container footer-main"><div class="footer-intro"><img src="/assets/wordmark.svg" alt="Little Home Ideas" width="420" height="70" class="footer-wordmark"/><p>Small ideas. Better living.</p><p>Thoughtful ways to make more of your home, garden, and everyday spaces.</p></div><nav aria-label="Footer explore"><h2>Explore the journal</h2><a href="/ideas/">All articles</a><a href="/small-spaces/">Small spaces &amp; storage</a><a href="/garden-patio/">Garden &amp; patio</a><a href="/diy-home/">DIY &amp; home updates</a></nav><nav aria-label="Footer reader tools"><h2>Make a plan</h2><a href="/tools/patio-privacy-planner/">Patio &amp; Balcony Planner</a><a href="/ideas/#saved-view">Your saved ideas</a><a href="/ideas/#article-search">Find a guide</a></nav><nav aria-label="Footer information"><h2>Little Home Ideas</h2><a href="/about/">About the journal</a><a href="/editorial-policy/">Editorial approach</a><a href="/contact/">Contact</a></nav></div><div class="container footer-bottom"><p>© {new Date().getUTCFullYear()} Little Home Ideas</p><nav aria-label="Legal information"><a href="/privacy/">Privacy</a>{analyticsActive && <button type="button" class="footer-analytics-choice" data-analytics-settings>Analytics choices</button>}<a href="/disclosure/">Affiliate disclosure</a></nav><a class="back-top" href="#top">Back to top ↑</a></div></footer>
{analyticsActive && <AnalyticsConsent measurementId={analyticsId}/>}
<div class="save-announcement sr-only" role="status" aria-live="polite" id="save-announcement"></div><script>import '../scripts/magazine.js';</script></body></html>
