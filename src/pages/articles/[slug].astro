---
import {render} from 'astro:content';import Base from '../../layouts/Base.astro';import Card from '../../components/Card.astro';import {publishedArticles,articleUrl} from '../../data/articles';import {categories} from '../../data/categories';
export async function getStaticPaths(){return (await publishedArticles()).map(article=>({params:{slug:article.id},props:{article}}));}
const {article}=Astro.props;const d=article.data;const {Content,headings}=await render(article);const category=categories.find(c=>c.slug===d.category);const all=await publishedArticles();const related=all.filter(a=>a.id!==article.id).sort((a,b)=>Number(b.data.category===d.category)-Number(a.data.category===d.category)).slice(0,3);
const schema={'@context':'https://schema.org','@type':'Article',headline:d.title,description:d.description,image:new URL(d.image.replace('.svg','.png'),Astro.site).href,datePublished:d.date.toISOString(),dateModified:(d.updated||d.date).toISOString(),author:{'@type':'Organization',name:'Little Home Ideas',url:new URL('/about/',Astro.site).href},publisher:{'@type':'Organization',name:'Little Home Ideas',logo:{'@type':'ImageObject',url:new URL('/assets/wordmark.png',Astro.site).href}},mainEntityOfPage:new URL(articleUrl(article.id),Astro.site).href};
---
<Base title={d.title} description={d.description} image={d.image} schema={schema}><header class="container article-heading"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={`/${category.slug}/`}>{category.name}</a></nav><p class="eyebrow">{category.name}</p><h1>{d.title}</h1><p class="lead">{d.description}</p><p class="byline">By <a href="/about/">Little Home Ideas</a> · <time datetime={d.date.toISOString()}>{d.date.toLocaleDateString('en-US',{timeZone:'UTC',month:'long',day:'numeric',year:'numeric'})}</time> · Editorially reviewed</p><figure><img class="article-cover" src={d.image} alt={d.imageAlt} width="960" height="640"/><figcaption>Original Little Home Ideas illustration. Schematic, not to scale.</figcaption></figure></header>
<div class="container article-layout"><aside class="toc"><p class="eyebrow">In this guide</p><nav aria-label="Table of contents">{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside><article class="prose"><Content/>{d.sources.length>0 && <section class="sources"><h2>Sources and further reading</h2><ul>{d.sources.map(s=><li><a href={s.url} rel="noopener noreferrer">{s.title}</a></li>)}</ul><p class="small">Safety and technical references checked October 13, 2026. Layouts and planning examples are editorial suggestions, not tested product claims.</p></section>}<div class="notice">No products were independently tested for this guide. Check your lease, product instructions, and local requirements before making changes.</div></article></div>
<section class="container section"><p class="eyebrow">Keep exploring</p><h2>A few more useful ideas</h2><div class="article-grid">{related.map(article=><Card article={article}/>)}</div></section></Base>
