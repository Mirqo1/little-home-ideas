---
import Base from '../layouts/Base.astro';import Card from '../components/Card.astro';import {categories} from '../data/categories';import {publishedArticles} from '../data/articles';import pages from '../data/pages.json';import ContactPrivacy from '../components/ContactPrivacy.astro';
export function getStaticPaths(){return [...categories.map(c=>({params:{section:c.slug},props:{category:c}})),{params:{section:'ideas'},props:{category:null}},...pages.filter(page=>page.slug!=='contact').map(page=>({params:{section:page.slug},props:{page}}))];}
const {category,page}=Astro.props;const articles=page?[]:(await publishedArticles()).filter(a=>!category || a.data.category===category.slug);
---
<Base title={page?.title || category?.name || 'All ideas'} description={page?.description || category?.description || 'Browse practical guides to small spaces, garden and patio, DIY updates, renter-friendly living, and everyday home solutions.'} noindex={page?.slug==='contact'}>
{page ? <div class="container information prose"><Fragment set:html={page.body}/>{page.slug==='privacy' && <ContactPrivacy/>}</div> : <><header class="container page-intro"><p class="eyebrow">The Little Home Ideas journal</p><h1>{category?.name || 'Ideas for better everyday living'}</h1><p class="lead">{category?.description || 'Small improvements, useful details, and thoughtful ways to make your space work for you.'}</p><nav class="category-tabs" aria-label="Filter by category"><a href="/ideas/" aria-current={!category?'page':undefined}>All</a>{categories.map(c=><a href={`/${c.slug}/`} aria-current={category?.slug===c.slug?'page':undefined}>{c.name}</a>)}</nav></header><section class="container section"><div class="archive-controls"><div><label for="article-search">Find a guide</label><input id="article-search" type="search" placeholder="Try patio, storage, or rental..." autocomplete="off"/></div><button type="button" class="saved-filter" id="saved-view" aria-pressed="false" hidden>Show saved ideas <span data-saved-count>0</span></button><p class="small archive-status" id="archive-status" role="status"></p></div><p class="empty-search" id="empty-search" hidden>No matching guides. Try another search or show all articles.</p><div class="article-grid" data-archive>{articles.map(article=><Card article={article}/>)}</div></section></>}
</Base>
