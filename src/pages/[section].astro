---
import Base from '../layouts/Base.astro';import Card from '../components/Card.astro';import {categories} from '../data/categories';import {publishedArticles} from '../data/articles';import pages from '../data/pages.json';
export function getStaticPaths(){return [...categories.map(c=>({params:{section:c.slug},props:{category:c}})),{params:{section:'ideas'},props:{category:null}},...pages.map(page=>({params:{section:page.slug},props:{page}}))];}
const {category,page}=Astro.props;const articles=page?[]:(await publishedArticles()).filter(a=>!category || a.data.category===category.slug);
---
<Base title={page?.title || category?.name || 'All ideas'} description={page?.description || category?.description || 'Browse practical guides to small spaces, garden and patio, DIY updates, renter-friendly living, and everyday home solutions.'} noindex={page?.slug==='contact'}>
{page ? <div class="container information prose" set:html={page.body}/> : <><header class="container page-intro"><p class="eyebrow">The Little Home Ideas journal</p><h1>{category?.name || 'Ideas for better everyday living'}</h1><p class="lead">{category?.description || 'Small improvements, useful details, and thoughtful ways to make your space work for you.'}</p><nav class="category-tabs" aria-label="Filter by category"><a href="/ideas/" aria-current={!category?'page':undefined}>All</a>{categories.map(c=><a href={`/${c.slug}/`} aria-current={category?.slug===c.slug?'page':undefined}>{c.name}</a>)}</nav></header><section class="container section"><div class="article-grid">{articles.map(article=><Card article={article}/>)}</div></section></>}
</Base>
