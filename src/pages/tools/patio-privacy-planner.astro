import Base from '../../layouts/Base.astro';
---
<Base title="Patio Privacy Planner" description="Explore removable patio privacy options and a simple screening-width estimate, with balcony and wind checks. Free and no sign-up."><header class="container page-intro"><p class="eyebrow">Free interactive tool</p><h1>Patio Privacy Planner</h1><p class="lead">A few answers. A clearer starting point. Explore ideas and a paper-layout estimate before shopping.</p></header><section class="container section tool-grid"><form class="panel" id="privacy-form"><label for="space">Your outdoor space</label><select id="space"><option value="patio">Ground-level patio</option><option value="balcony">Balcony</option></select><label for="width">Width you want to screen (feet)</label><input id="width" type="number" min="1" max="100" step="0.5" value="6" required/><label for="panel-width">Example module width for a paper layout (feet)</label><input id="panel-width" type="number" min="1" max="10" step="0.5" value="3" required/><p class="small">This is an assumption you choose, not a recommended product size.</p><label for="budget">Planning budget (USD)</label><select id="budget"><option value="low">Under $100</option><option value="medium" selected>$100–$300</option><option value="high">Over $300</option></select><label for="need">Main priority</label><select id="need"><option value="view">Block a direct sightline</option><option value="flex">Easy to move or remove</option><option value="green">Add greenery</option></select><label for="exposure">Wind exposure</label><select id="exposure"><option value="exposed" selected>Exposed or unsure</option><option value="sheltered">Sheltered; product limits still apply</option></select><label class="check-label"><input type="checkbox" id="approved"/> I have confirmed building permission, permitted loads, drainage, and wind restrictions for balcony items.</label><p><button class="button" type="submit">See starting ideas ↗</button></p><p class="small">This tool does not transmit or save your answers.</p><noscript><p>The interactive estimate needs JavaScript. Read our <a href="/articles/patio-privacy-ideas-for-renters/">patio privacy guide</a> for the same planning principles.</p></noscript></form><section class="panel" aria-live="polite" aria-atomic="true"><h2>Your starting options</h2><div id="results"><p>Enter your preferences and choose <strong>See starting ideas</strong>.</p><p class="small">This is an idea finder, not a safety approval, structural assessment, or price quote.</p></div></section></section><div class="container prose" style="max-width:860px"><div class="notice"><strong>Before installation:</strong> Building rules, wind, wet planter weight, clear exits, and exact product instructions matter. Do not attach screens, fabric, or planters to balcony railings without explicit approval and appropriate professional guidance.</div><p>Continue with our <a href="/articles/patio-privacy-ideas-for-renters/">patio privacy guide</a> or <a href="/articles/small-patio-furniture-layout/">small patio layout plan</a>.</p></div><script type="module" src="/assets/planner.js" is:inline></script></Base>
