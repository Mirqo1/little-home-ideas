---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import {publishedArticles} from '../data/articles';
const articles=await publishedArticles();
const featured=['organize-small-kitchen-drawers','small-patio-furniture-layout','reversible-living-room-updates'].map(id=>articles.find(a=>a.id===id)).filter(Boolean);
const topics=[
 {href:'/small-spaces/',label:'Small spaces',text:'Less clutter. More room to live.',image:'/assets/editorial-kitchen.webp',alt:'Illustrative neatly organized wooden kitchen drawer.'},
 {href:'/garden-patio/',label:'Garden & patio',text:'Make your little outdoors feel bigger.',image:'/assets/editorial-patio.webp',alt:'Illustrative garden patio with two chairs and leafy plants.'},
 {href:'/diy-home/',label:'DIY & home',text:'Small updates that make it yours.',image:'/assets/editorial-living.webp',alt:'Illustrative warm living room with neutral furniture and green walls.'}
];
---
<Base title="Little Home Ideas | Small ideas. Better living." description="Practical ideas for small spaces, garden and patio, and simple home updates. Find your next small improvement with Little Home Ideas." image="/assets/home-patio-hero.webp">
<section class="home-hero" aria-labelledby="home-title">
 <div class="hero-copy"><p class="eyebrow">Small ideas. Better living.</p><h1 id="home-title">A little change.<br/>A lovelier home.</h1><p>Make more of the space you have. Discover simple ideas for a calmer home, a greener patio, and everyday living.</p><a class="button" href="#explore">Explore the ideas <span aria-hidden="true">→</span></a></div>
 <picture class="hero-photo"><source media="(max-width:640px)" srcset="/assets/home-patio-hero-800.webp"/><img src="/assets/home-patio-hero.webp" alt="Illustrative sunlit living room opening onto a leafy garden patio." width="1800" height="600" fetchpriority="high"/></picture>
</section>
<section class="container section topic-section" id="explore" aria-labelledby="topics-title">
 <div class="section-heading"><div><p class="eyebrow">Find your starting point</p><h2 id="topics-title">What would you like to improve?</h2></div><a class="text-link" href="/ideas/">Browse all ideas <span aria-hidden="true">→</span></a></div>
 <div class="topic-grid">{topics.map(t=><a class="topic-card" href={t.href}><img src={t.image} alt={t.alt} width="1200" height="800" loading="lazy"/><div><h3>{t.label}<span aria-hidden="true">↗</span></h3><p>{t.text}</p></div></a>)}</div>
 <div class="more-topics"><span>Also explore</span><a href="/renter-friendly/">Renter-friendly living <span aria-hidden="true">→</span></a><a href="/practical-solutions/">Everyday home solutions <span aria-hidden="true">→</span></a></div>
</section>
<section class="journal-band" aria-labelledby="guides-title"><div class="container section">
 <div class="section-heading"><div><p class="eyebrow">From the journal</p><h2 id="guides-title">One good idea to begin with.</h2></div><a class="text-link" href="/ideas/">See all guides <span aria-hidden="true">→</span></a></div>
 <div class="article-grid">{featured.map(article=><Card article={article}/>)}</div>
</div></section>
<section class="container section" aria-labelledby="tool-title"><div class="home-tool">
 <div class="tool-copy"><p class="eyebrow">A useful little tool</p><h2 id="tool-title">Your outdoor space.<br/>See the possibilities.</h2><p>Visualize a balcony or patio in 3D. Arrange seating, storage, and plants, add doors and windows, and try privacy screens before making a shopping list.</p><a class="button light" href="/tools/patio-privacy-planner/">Try the free planner <span aria-hidden="true">→</span></a><p class="tool-note">Free to use · No account needed</p></div>
 <img src="/assets/editorial-patio.webp" alt="Illustrative compact patio surrounded by greenery." width="1200" height="800" loading="lazy"/>
</div></section>
</Base>
