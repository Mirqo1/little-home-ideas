---
import Base from '../layouts/Base.astro';import Card from '../components/Card.astro';import {publishedArticles,articleUrl} from '../data/articles';import {categories} from '../data/categories';import {categoryVisuals} from '../data/visuals';
const articles=await publishedArticles();const byId=(id:string)=>articles.find(a=>a.id===id);const featured=byId('reversible-living-room-updates');const latest=['organize-small-kitchen-drawers','patio-privacy-ideas-for-renters','reversible-living-room-updates'].map(id=>byId(id)).filter(Boolean);
---
<Base title="Little Home Ideas | Small ideas. Better living." description="Fresh ideas for small spaces, greener patios, and a home that works for you. Explore practical guides and free planning tools.">
<section class="container modern-hero"><div class="hero-copy"><p class="eyebrow hero-kicker"><span></span> Small ideas. Better living.</p><h1>Little changes.<br/><span>Big possibilities.</span></h1><p class="hero-lead">Make more of the home you have. Smart storage, greener corners, and small updates worth trying.</p><div class="hero-actions"><a class="button" href="#journal">Find your next idea →</a><a class="text-link" href="/tools/">Explore free tools</a></div><div class="hero-footnote"><span class="small-star" aria-hidden="true">✳</span><p>A little inspiration.<br/><strong>A lot you can make your own.</strong></p></div></div><div class="hero-visual"><img src="/assets/editorial-living.webp" alt="Illustrative compact living room with a cream sofa, orange chair, olive wall, and natural textures." width="960" height="640" fetchpriority="high"/><a class="hero-story" href={articleUrl(featured.id)}><span class="story-tag">The small-space edit</span><h2>A fresh room.<br/>A smaller project.</h2><span>Explore reversible updates →</span></a><span class="hero-stamp" aria-hidden="true">MAKE<br/>ROOM FOR<br/>BETTER</span></div></section>
<section class="container journal-section" id="journal"><div class="section-heading"><div><p class="eyebrow">The journal</p><h2>Your next good idea.</h2></div><a class="text-link" href="/ideas/">All articles →</a></div><div class="article-grid">{latest.map(article=><Card article={article}/>)}</div></section>
<section class="discovery-section"><div class="container discovery-layout"><div class="discovery-heading"><p class="eyebrow">Start somewhere small</p><h2>What would you<br/>like to make better?</h2><p>Pick a corner of your home.<br/>We'll point you toward a useful first step.</p><span class="discovery-mark" aria-hidden="true">✳</span></div><div class="discovery-options">{categories.map((c,i)=><a href={`/${c.slug}/`}><span class="discovery-number">0{i+1}</span><span><strong>{c.navLabel}</strong><small>{c.description}</small></span><span class="round-arrow" aria-hidden="true">→</span></a>)}</div></div></section>
<section class="container inspiration-section"><div class="section-heading"><div><p class="eyebrow">Good things come in small spaces</p><h2>Less space. More life.</h2></div><p class="section-note">Two places to start.<br/>Plenty of room for your own ideas.</p></div><div class="inspiration-grid"><a class="inspiration-card" href="/garden-patio/"><img src="/assets/editorial-patio.webp" alt="Illustrative small patio with green chairs, flowers, and terracotta containers." width="960" height="640" loading="lazy"/><div><span class="story-tag">The outdoor edit</span><h3>Your own little escape.</h3><p>Patios, plants, and a more inviting patch of outdoors.</p><span class="text-link">Garden & patio →</span></div></a><a class="inspiration-card kitchen-story" href="/small-spaces/"><img src="/assets/editorial-kitchen.webp" alt="Illustrative organized kitchen drawer beside a bowl of lemons." width="960" height="640" loading="lazy"/><div><span class="story-tag">Room to breathe</span><h3>A place for the everyday.</h3><p>Simple systems that make compact spaces work harder.</p><span class="text-link">Small spaces & storage →</span></div></a></div></section>
<section class="container idea-finder-section" id="idea-finder"><div class="finder-intro"><p class="eyebrow">A little direction</p><h2>Find your<br/>starting point.</h2><p>Choose what you want to improve for a few relevant guides. No sign-up, no data sent.</p></div><div class="finder-widget"><label for="idea-goal">I want to...</label><select id="idea-goal"><option value="all">Explore a little of everything</option><option value="small-spaces">Make more room and get organized</option><option value="garden-patio">Make my outdoor space more inviting</option><option value="renter-friendly">Update my rental without permanent changes</option><option value="diy-home">Refresh a room with a small project</option><option value="practical-solutions">Solve an everyday home problem</option></select><div class="finder-results" id="finder-results" aria-live="polite">{articles.map(a=><a href={articleUrl(a.id)} data-finder-category={a.data.category}><span>{a.data.title}</span><span aria-hidden="true">→</span></a>)}</div><noscript><p>Choose a topic from the links above, or browse <a href="/ideas/">all guides</a>.</p></noscript></div></section>
<section class="planner-promo"><div class="container planner-promo-inner"><div><p class="eyebrow">Free tool. Real planning.</p><h2>A more private patio<br/>starts with a plan.</h2><p>Sketch your boundary, compare example screening widths, and save a checklist before shopping.</p><a class="button" href="/tools/patio-privacy-planner/">Build your privacy plan →</a></div><a class="planner-promo-card" href="/tools/patio-privacy-planner/"><div class="mini-window"><span></span><span></span><span></span><p>Patio Privacy Planner</p></div><img src="/assets/patio-layout.svg" alt="Original overhead patio plan showing a targeted screen, seating, plants, and a clear path." width="960" height="640" loading="lazy"/><div class="mini-metrics"><span><strong>01</strong> Measure</span><span><strong>02</strong> Explore</span><span><strong>03</strong> Save</span></div></a></div></section>
<section class="container editorial-note"><span class="small-star" aria-hidden="true">✳</span><div><h2>Inspiration with a practical side.</h2><p>Clear steps. Honest limitations. Sources where they matter. We never invent product tests or completed projects.</p></div><a class="text-link" href="/editorial-policy/">Our approach →</a></section>
</Base>
