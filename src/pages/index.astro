---
import Base from '../layouts/Base.astro';import Card from '../components/Card.astro';import {publishedArticles} from '../data/articles';import {categories} from '../data/categories';
const articles=await publishedArticles();const journal=['organize-small-kitchen-drawers','patio-privacy-ideas-for-renters','reversible-living-room-updates'].map(id=>articles.find(a=>a.id===id)).filter(Boolean);
---
<Base title="Little Home Ideas | Small ideas. Better living." description="A considered home, one small idea at a time. Practical guides for small spaces, garden and patio, and thoughtful home updates.">
<section class="architecture-hero"><picture><source media="(max-width:600px)" srcset="/assets/architecture-hero-small.webp"/><img src="/assets/architecture-hero.webp" alt="Illustrative bright dining space with neutral wood furniture, white walls, and simple architectural lines." width="1800" height="605" fetchpriority="high"/></picture><div class="architecture-hero-copy"><p class="eyebrow">The art of everyday living</p><h1>A considered home.<br/>One small idea<br/>at a time.</h1><p>Useful changes. Thoughtful spaces.<br/>A little inspiration for the home you have.</p><a class="button" href="#home-edit">Take a look</a></div></section>
<section class="home-manifesto"><div class="container"><p class="eyebrow">Small ideas. Better living.</p><h2>Make yourself at home.</h2><p>Good home ideas do more than look beautiful. They make a small room easier to use, a garden more inviting, or an everyday routine a little simpler.</p><span class="manifesto-signature">Little Home Ideas</span></div></section>
<section class="architecture-mosaic" id="home-edit" aria-label="Explore home ideas"><a class="mosaic-photo mosaic-bath" href="/articles/under-sink-storage-around-pipes/"><img src="/assets/architecture-bath.webp" alt="Illustrative compact white bathroom with a freestanding tub and natural wood accents." width="1200" height="800" loading="lazy"/><span class="photo-label">A little room to breathe →</span></a><div class="mosaic-text mosaic-storage"><p class="eyebrow">Small spaces &amp; storage</p><h2>Room for<br/>the everyday.</h2><p>Simple storage systems that work around the space you actually have.</p><a class="button" href="/small-spaces/">Explore storage</a></div><a class="mosaic-photo mosaic-detail" href="/articles/reversible-living-room-updates/"><img src="/assets/architecture-detail.webp" alt="Illustrative oak side table, ceramic cup, and pale curtain." width="1200" height="800" loading="lazy"/></a><div class="mosaic-text mosaic-updates"><p class="eyebrow">DIY &amp; home updates</p><h2>Small project.<br/>Fresh perspective.</h2><p>Make a room your own with thoughtful, reversible changes.</p><a class="button" href="/diy-home/">Find an update</a></div><a class="mosaic-photo mosaic-kitchen" href="/articles/organize-small-kitchen-drawers/"><img src="/assets/editorial-kitchen.webp" alt="Illustrative organized oak kitchen drawer with utensils and measuring tools." width="1200" height="800" loading="lazy"/></a><div class="mosaic-text mosaic-garden"><p class="eyebrow">Garden &amp; patio</p><h2>A greener corner.</h2><p>Make more of a modest patio, a few containers, or your own patch of outdoors.</p><a class="button" href="/garden-patio/">Step outside</a></div><a class="mosaic-photo mosaic-plants" href="/articles/container-garden-first-three-pots/"><img src="/assets/architecture-plants.webp" alt="Illustrative three white pots with leafy plants on a light oak shelf." width="1800" height="600" loading="lazy"/></a></section>
<section class="container section architectural-journal" id="journal"><div class="section-heading"><div><p class="eyebrow">The journal</p><h2>Ideas worth a closer look.</h2></div><a class="text-link" href="/ideas/">View all guides →</a></div><div class="article-grid">{journal.map(article=><Card article={article}/>)}</div></section>
<section class="architecture-tool"><div class="container architecture-tool-inner"><div class="tool-photo-frame"><img src="/assets/architecture-detail.webp" alt="Illustrative minimal corner with an oak table and pale curtain." width="1200" height="800" loading="lazy"/></div><div class="tool-editorial"><p class="eyebrow">A useful little tool</p><h2>More privacy.<br/>A clearer plan.</h2><p>Measure your patio, compare example screening widths, and save a practical checklist before shopping.</p><a class="button" href="/tools/patio-privacy-planner/">Open the planner</a><a class="text-link" href="/articles/patio-privacy-ideas-for-renters/">Read the privacy guide →</a></div></div></section>
<section class="container section architectural-finder" id="idea-finder"><div><p class="eyebrow">Find your starting point</p><h2>What would you<br/>like to improve?</h2><p>Choose a focus for a few useful guides.</p></div><div class="finder-widget"><label for="idea-goal">I want to...</label><select id="idea-goal"><option value="all">Explore a little of everything</option><option value="small-spaces">Make more room and get organized</option><option value="garden-patio">Make my outdoor space more inviting</option><option value="renter-friendly">Update my rental without permanent changes</option><option value="diy-home">Refresh a room with a small project</option><option value="practical-solutions">Solve an everyday home problem</option></select><div class="finder-results" id="finder-results" aria-live="polite">{articles.map(a=><a href={`/articles/${a.id}/`} data-finder-category={a.data.category}><span>{a.data.title}</span><span aria-hidden="true">→</span></a>)}</div><noscript><p>Browse <a href="/ideas/">all guides</a> or choose a topic in the navigation.</p></noscript></div></section>
<section class="architecture-values"><div class="container"><h2>Thoughtful ideas. Honest guidance.</h2><p>Practical steps, clear limitations, and sources where they matter. No invented product tests or completed projects.</p><a class="text-link" href="/editorial-policy/">Our editorial approach →</a></div></section>
</Base>
