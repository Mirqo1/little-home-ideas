---
import Base from '../layouts/Base.astro';import Card from '../components/Card.astro';import {publishedArticles} from '../data/articles';import {categories} from '../data/categories';
const articles=await publishedArticles();
---
<Base title="Little Home Ideas | Small ideas. Better living." description="Practical guides for small spaces, gardens, renter-friendly updates, and everyday home questions. Thoughtful ideas and free tools for real homes.">
<section class="hero"><picture><source media="(max-width:600px)" srcset="/assets/home-patio-hero-800.webp"/><img src="/assets/home-patio-hero.webp" alt="A calm cream and oak living room opening onto a compact patio with potted plants." width="1600" height="536" fetchpriority="high"/></picture><div class="hero-content"><p class="eyebrow">A little inspiration. A little possibility.</p><h1>Small ideas.<br/>Better living.</h1><p>Make more of the space you have.<br/>One thoughtful change at a time.</p><a class="button" href="/ideas/">Find your next idea <span aria-hidden="true">↗</span></a></div></section>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">The journal</p><h2>Latest articles</h2></div><a class="text-link" href="/ideas/">Browse all guides ↗</a></div><div class="article-grid">{articles.slice(0,3).map(article=><Card article={article}/>)}</div></section>
<section class="category-section"><div class="container section"><p class="eyebrow">Make yourself at home</p><h2>Browse by topic</h2><div class="category-list">{categories.map(c=><a href={`/${c.slug}/`}><span class="category-number">{c.number}</span><div><h3>{c.name}</h3><p>{c.description}</p></div><span aria-hidden="true">↗</span></a>)}</div></div></section>
<section class="container section tool-feature"><div><p class="eyebrow">Less guesswork. More possibilities.</p><h2>Patio Privacy Planner</h2><p>Find removable privacy options for your outdoor space. Our free planner turns a few simple answers into a useful starting point.</p><a class="button" href="/tools/patio-privacy-planner/">Plan your patio privacy ↗</a></div><img src="/assets/patio-layout.svg" alt="Overhead diagram of a small patio with seating, plants, and an open walkway." width="960" height="640" loading="lazy"/></section>
<section class="container section promise"><p class="eyebrow">The Little Home Ideas approach</p><h2>How we create our guides</h2><p>Clear steps, realistic trade-offs, and a little room for your own creativity. No invented product tests or perfect-home promises.</p><a class="text-link" href="/editorial-policy/">Get to know our approach ↗</a></section>
</Base>
