---
import Base from '../layouts/Base.astro';import Card from '../components/Card.astro';import {publishedArticles} from '../data/articles';import {categories} from '../data/categories';
const articles=await publishedArticles();
---
<Base title="Little Home Ideas | Small ideas. Better living." description="Practical guides for small spaces, gardens, renter-friendly updates, and everyday home questions. Thoughtful ideas and free tools for real homes.">
<section class="hero"><picture><source media="(max-width:600px)" srcset="/assets/home-patio-hero-800.webp"/><img src="/assets/home-patio-hero.webp" alt="A calm cream and oak living room opening onto a compact patio with potted plants." width="1600" height="536" fetchpriority="high"/></picture><div class="hero-content"><p class="eyebrow">A little inspiration. A little possibility.</p><h1>Small ideas.<br/>Better living.</h1><p>Make more of the space you have.<br/>One thoughtful change at a time.</p><a class="button" href="/ideas/">Find your next idea <span aria-hidden="true">→</span></a></div></section>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">The journal</p><h2>Latest articles</h2></div><a class="text-link" href="/ideas/">Browse all guides ↗</a></div><div class="article-grid">{articles.slice(0,3).map(article=><Card article={article}/>)}</div></section>
<section class="topic-section"><div class="container section"><div class="section-heading"><div><p class="eyebrow">Find your kind of idea</p><h2>Browse by topic</h2></div><p class="topic-intro">One room, one project, or one everyday problem.<br/>Start with what matters to you.</p></div><div class="topic-grid">{categories.map((c,i)=><a class={`topic-card topic-${c.slug}`} href={`/${c.slug}/`}><span class="topic-icon" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{i===0 && <><path d="M13 13h38v38H13zM13 31h38M31 13v18M13 40h38"/><path d="M20 35h5M39 35h5M25 45h14"/></>}{i===1 && <><path d="M22 37h23l-4 16H26zM33 37V14M33 25c-13 0-17-8-16-13 11 0 16 5 16 13ZM33 32c13 0 17-8 16-13-11 0-16 5-16 13Z"/></>}{i===2 && <><path d="m11 27 21-17 21 17M17 24v29h30V24M26 53V37h12v16"/><path d="m42 10 10 10M47 7l8 8M43 21 34 30"/></>}{i===3 && <><path d="M16 12h30v42H16zM23 47h16M35 31h2M10 54h43"/><path d="M46 22h8v24h-8"/></>}{i===4 && <><path d="M17 10h30v44H17zM24 8h16v8H24zM24 28l3 3 6-7M24 41l3 3 6-7M37 28h5M37 41h5"/></>}</svg></span><h3>{c.name}</h3><p>{c.description}</p><span class="topic-link">Explore <span aria-hidden="true">→</span></span></a>)}</div></div></section>
<section class="container section tool-feature"><div><p class="eyebrow">Less guesswork. More possibilities.</p><h2>Patio Privacy Planner</h2><p>Choose a privacy approach, see a dimensioned sketch, and save a practical checklist for your patio or balcony. No account needed.</p><a class="button" href="/tools/patio-privacy-planner/">Plan your patio privacy ↗</a></div><img src="/assets/patio-layout.svg" alt="Overhead diagram of a small patio with seating, plants, and an open walkway." width="960" height="640" loading="lazy"/></section>
<section class="container section promise"><p class="eyebrow">What you can expect here</p><h2>Useful guides, without the guesswork.</h2><div class="promise-grid"><div><h3>Clear, practical steps</h3><p>Measurements, checklists, and options you can adapt to your own space.</p></div><div><h3>Honest about limitations</h3><p>We flag safety checks and never claim to have tested something we haven't.</p></div><div><h3>Sources where they matter</h3><p>Technical guidance links to relevant expert and manufacturer references.</p></div></div><a class="text-link" href="/editorial-policy/">How we create our guides →</a></section>
</Base>
